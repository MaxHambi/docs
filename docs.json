{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Lagerplatz-Barcode-Generator",
  "theme": "aspen",
  "colors": {
    "primary": "#8839EF",
    "light": "#CBA6F7",
    "dark": "#CBA6F7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Benutzerhandbuch",
        "groups": [
          {
            "group": "Einstieg",
            "pages": [
              "index",
              "quickstart",
              "login-und-passwortschutz"
            ]
          },
          {
            "group": "Arbeiten mit der Web-App",
            "pages": [
              "vorlagen-und-eintraege",
              "konfiguration",
              "vorschau-und-erzeugung"
            ]
          },
          {
            "group": "Betrieb & Automatisierung",
            "pages": [
              "lokales-setup",
              "cli"
            ]
          },
          {
            "group": "Hilfe",
            "pages": [
              "protokoll-und-fehlerbehebung",
              "faq"
            ]
          },
          {
            "group": "Entwicklung",
            "pages": [
              "entwicklung/architektur",
              "entwicklung/api-referenz",
              "entwicklung/error-handling",
              "entwicklung/roadmap"
            ]
          }
        ]
      },
      {
        "tab": "Entwickler-Referenz",
        "groups": [
          {
            "group": "Referenz",
            "pages": [
              "api-reference",
              "error-handling",
              "roadmap"
            ]
          }
        ]
      }
    ]
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "catppuccin-latte",
        "dark": "catppuccin-mocha"
      }
    },
    "eyebrows": "section"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "windows"
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Josefin Sans",
      "weight": 700
    },
    "body": {
      "family": "Source Sans Pro",
      "weight": 500
    }
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "download-pdf",
      "copy",
      "assistant",
      "view"
    ],
    "display": "header"
  },
  "interaction": {
    "drilldown": true
  }
}
